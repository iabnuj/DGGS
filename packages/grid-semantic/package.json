{
  "name": "@dggs/grid-semantic",
  "version": "0.1.0",
  "description": "格级语义向量：特征、相似检索、要素类别映射",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build-fast": "tsup src/index.ts --format cjs,esm --dts",
    "build": "pnpm run build-fast",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "6.6.3",
    "typescript": "4.9.5",
    "vitest": "0.28.5"
  }
}
