{
  "name": "@dggs/grid-store",
  "version": "0.1.0",
  "description": "网格化数据仓：可插拔存储引擎（Memory / JSON / SQLite）",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    }
  },
  "scripts": {
    "build-fast": "tsup src/index.ts src/node.ts --format cjs,esm --dts",
    "build": "pnpm run build-fast",
    "test": "vitest run",
    "test:sqlite": "pnpm run build-fast && ELECTRON_RUN_AS_NODE=1 node ../../apps/demo/node_modules/electron/cli.js ./scripts/test-sqlite.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@dggs/grid-ingest": "workspace:*",
    "better-sqlite3": "^13.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "tsup": "6.6.3",
    "typescript": "4.9.5",
    "vite": "^5.4.21",
    "vitest": "0.28.5"
  }
}
