{
  "name": "dggs",
  "private": true,
  "scripts": {
    "demo": "pnpm --filter @dggs/demo dev",
    "demo:electron": "pnpm --filter @dggs/demo electron:dev",
    "demo:dist": "pnpm --filter @dggs/demo electron:dist",
    "build:core": "pnpm --filter @dggs/grid-core build-fast",
    "build:ingest": "pnpm --filter @dggs/grid-ingest build",
    "build:store": "pnpm --filter @dggs/grid-store build",
    "test:core": "pnpm --filter @dggs/grid-core test",
    "test:ingest": "pnpm --filter @dggs/grid-ingest test",
    "test:store": "pnpm --filter @dggs/grid-store test",
    "test:store:sqlite": "pnpm --filter @dggs/grid-store test:sqlite"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
