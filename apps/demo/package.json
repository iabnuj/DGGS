{
  "name": "@dggs/demo",
  "version": "0.1.0",
  "description": "DGGS GeoSOT + Cesium desktop demo",
  "author": "DGGS",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:dist": "pnpm -w run build:store && node scripts/vendor-store.mjs && pnpm run build && pnpm exec electron-rebuild -f -w better-sqlite3 && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@dggs/grid-core": "workspace:*",
    "@dggs/grid-ingest": "workspace:*",
    "@dggs/grid-store": "workspace:*",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-sqlite3": "^13.0.1",
    "cesium": "^1.125.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-cesium": "^1.2.23"
  }
}
